SELECT ?entity ?newLabel
WHERE
{
    VALUES (?graph ?class) {
        (<dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> qudt:Unit)
        (<dist:vocab:VOCAB_QUDT-QUANTITY-KINDS-ALL.ttl> qudt:QuantityKind)
        (<dist:vocab:VOCAB_QUDT-CONSTANTS.ttl> qudt:PhysicalConstant)
        (<dist:vocab:VOCAB_QUDT-PREFIXES.ttl> qudt:Prefix)
    }
    {
        GRAPH ?graph {
            ?entity a ?class .
            FILTER NOT EXISTS { ?entity qudt:deprecated true }
            ?entity rdfs:label ?label.
            BIND(LANG(?label) AS ?lang)
            FILTER(?lang = "en")
            FILTER NOT EXISTS {
                ?entity rdfs:label ?noDefaultLabel;
                FILTER(LANG(?noDefaultLabel) = "")
            }
        }
        BIND(STR(?label) as ?newLabel)
    } UNION {
        GRAPH ?graph {
                ?entity a ?class .
                FILTER NOT EXISTS { ?entity qudt:deprecated true }
                ?entity rdfs:label ?label.
                BIND(LANG(?label) AS ?lang)
                FILTER(?lang = "")
                FILTER NOT EXISTS {
                    ?entity rdfs:label ?noENLabel;
                    FILTER(LANG(?noENLabel) = "en")
                }
            }
            BIND(STRLANG(STR(?label),"en") as ?newLabel)
    }
}
ORDER BY ?entity
