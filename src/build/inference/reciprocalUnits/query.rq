# using a custom query approach instead of the SHACL-based sparql2shacl approach
# because with SHACL it just takes too long to compute the reciprocal units :
# - based on SHACL we need one query execution per unit
# - with this approach, we need one query execution to get everything
CONSTRUCT {
    ?this qudt:hasReciprocalUnit ?reciprocalUnit .
}
#SELECT ?this ?thisScalar ?reciprocalUnit ?reciprocalScalar
WHERE {
    {
        {
            {
                SELECT ?this (GROUP_CONCAT(?singleSig) as ?sig)
                WHERE {
                    {
                        SELECT ?this ?singleSig
                        WHERE {
                            {
                                GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> {
                                    ?this qudt:hasFactorUnit [
                                        qudt:hasUnit ?base ;
                                        qudt:exponent ?exp
                                    ]
                                }
                                FILTER NOT EXISTS {
                                    GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [] }
                                    FILTER NOT EXISTS {
                                        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e ] }
                                        FILTER NOT EXISTS {
                                            GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e2 ] }
                                            FILTER(?e2 = -1 * ?e)
                                        }
                                    }
                                }
                                BIND(CONCAT(qfn:localname(?base),"^",STR(?exp)) AS ?singleSig)
                            } UNION {
                                # a unit whose factor units are their own negation (rad = m/m, sr = m2/m2) says nothing about
                                # what is inverted, so it counts as one factor: itself (rad is then the reciprocal of PER-RAD)
                                {
                                    SELECT DISTINCT ?this
                                    WHERE {
                                        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [] }
                                        FILTER NOT EXISTS {
                                            GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e ] }
                                            FILTER NOT EXISTS {
                                                GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e2 ] }
                                                FILTER(?e2 = -1 * ?e)
                                            }
                                        }
                                    }
                                }
                                BIND(CONCAT(qfn:localname(?this),"^1") AS ?singleSig)
                            }
                        }
                        ORDER BY ?this ?base ?exp
                    }
                } GROUP BY ?this
            }
            {
                SELECT ?reciprocalUnit (GROUP_CONCAT(?singleSig) as ?reciprocalSig)
                WHERE {
                    {
                        SELECT (?unit as ?reciprocalUnit) ?singleSig
                        WHERE {
                            {
                                GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> {
                                    ?unit qudt:hasFactorUnit [
                                        qudt:hasUnit ?base ;
                                        qudt:exponent ?exp
                                    ]
                                }
                                FILTER NOT EXISTS {
                                    GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [] }
                                    FILTER NOT EXISTS {
                                        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e ] }
                                        FILTER NOT EXISTS {
                                            GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e2 ] }
                                            FILTER(?e2 = -1 * ?e)
                                        }
                                    }
                                }
                                BIND(?exp * -1 as ?negExp)
                                BIND(CONCAT(qfn:localname(?base),"^",STR(?negExp)) AS ?singleSig)
                            } UNION {
                                {
                                    SELECT DISTINCT ?unit
                                    WHERE {
                                        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [] }
                                        FILTER NOT EXISTS {
                                            GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e ] }
                                            FILTER NOT EXISTS {
                                                GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?unit qudt:hasFactorUnit [ qudt:hasUnit ?b ; qudt:exponent ?e2 ] }
                                                FILTER(?e2 = -1 * ?e)
                                            }
                                        }
                                    }
                                }
                                BIND(CONCAT(qfn:localname(?unit),"^-1") AS ?singleSig)
                            }
                        }
                        ORDER BY ?unit ?base ?negExp
                    }
                } GROUP BY ?reciprocalUnit
            }
        }
        FILTER(?sig = ?reciprocalSig)
        FILTER(?this != ?reciprocalUnit)
    }
    OPTIONAL {
        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> {
            ?this qudt:factorUnitScalar ?thisScalarOpt .
        }
    }
    OPTIONAL {
        GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> {
            ?reciprocalUnit qudt:factorUnitScalar ?reciprocalScalarOpt .
        }
    }
    BIND(COALESCE(?thisScalarOpt, 1.0) AS ?thisScalar)
    BIND(COALESCE(?reciprocalScalarOpt, 1.0) as ?reciprocalScalar)
    FILTER(?thisScalar = 1 / ?reciprocalScalar)
    # exclude deprecated units from reciprocal-unit inference (either endpoint)
    FILTER NOT EXISTS { GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this qudt:deprecated true } }
    FILTER NOT EXISTS { GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?reciprocalUnit qudt:deprecated true } }
    # matching factor units is not enough: contextual units (GM_Carbon, GM_DRY, ...) and the dose units gray and
    # sievert share factor units with plain units (1/g, J/kg) but measure something else, so they get no reciprocal
    FILTER NOT EXISTS { GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?this a qudt:ContextualUnit } }
    FILTER NOT EXISTS { GRAPH <dist:vocab:VOCAB_QUDT-UNITS-ALL.ttl> { ?reciprocalUnit a qudt:ContextualUnit } }
    FILTER(?this NOT IN (<http://qudt.org/vocab/unit/GRAY>, <http://qudt.org/vocab/unit/SV>))
    FILTER(?reciprocalUnit NOT IN (<http://qudt.org/vocab/unit/GRAY>, <http://qudt.org/vocab/unit/SV>))
} ORDER BY ?this