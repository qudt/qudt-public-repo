@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix datatype: <http://qudt.org/vocab/datatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/quantities/invalid>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/invalid> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:label "QUDT Examples of Invalid Quantities v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_INVALID-QUANTITIES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:EX_Collection_Temperature_Values_INVALID
  a qudt:Collection ;
  dcterms:description """
  <p>TBD
  </p>"""^^rdf:HTML ;
  qudt:datatype datatype:DECIMAL ;
  qudt:quantity ex:Room_Temperature ;
  qudt:value ( 54.0 55.6 56.9 61.2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities/invalid> ;
  rdfs:label "Example of a invalid collection of temperature values" .

ex:Quantity_RoomTemperature-INVALID
  a qudt:Quantity ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_F ;
  qudt:value ex:List_Decimal_Values_INVALID ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities/invalid> ;
  rdfs:label "Room Temperature" .

ex:Room_Temperature
  a qudt:Quantity ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities/invalid> ;
  rdfs:label "Room Temperature" .

vaem:GMD_INVALID-QUANTITIES
  a vaem:GraphMetaData ;
  dcterms:description """
  Invalid examples of quantities, and of a collection of quantities.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:label "QUDT Examples of Invalid Quantities - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/quantities/invalid> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Invalid Quantities - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


