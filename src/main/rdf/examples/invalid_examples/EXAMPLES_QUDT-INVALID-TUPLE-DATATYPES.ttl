@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:label "QUDT Examples of Invalid Tuple Datatypes v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_INVALID-TUPLE-DATATYPES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:badExampleMemberSpecQuantityKind
  a qudt:NTupleMemberTypeSpec ;
  dcterms:description """
  <p>The position's qudt:hasQuantityKind is unit:M, which is a unit, not a quantity kind.</p>"""^^rdf:HTML ;
  qudt:hasQuantityKind unit:M ;
  qudt:index 1 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "Invalid tuple member spec - its quantity kind is a unit" ;
  sh:datatype xsd:decimal .

ex:badExampleQuantityValueTuple
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_QuantityValueUnit ;
  qudt:values ( quantitykind:Temperature 25.6 "DegC" ) .

ex:badExampleTuple2a
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_StatusFlag ;
  qudt:values ( "Approved" 42 ) .

ex:badExampleTuple2b
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_StatusFlag ;
  qudt:values ( "Approved" true 42 ) .

ex:badExampleTuple3
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_Measurement ;
  qudt:values ( "2026-05-12"^^xsd:date 23.7 42 ) .

ex:badExampleTupleDateInDateTimePosition
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalTemporal ;
  qudt:values ( "2026-05-12"^^xsd:date "14:30:00"^^xsd:time "2026-05-12"^^xsd:date
    "2026-05-12T14:30:00Z"^^xsd:dateTimeStamp "2026"^^xsd:gYear "--05"^^xsd:gMonth "---12"^^xsd:gDay
    "2026-05"^^xsd:gYearMonth "--05-12"^^xsd:gMonthDay "P1Y2M3DT4H"^^xsd:duration
    "P3DT4H"^^xsd:dayTimeDuration "P1Y2M"^^xsd:yearMonthDuration ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "xsd:date in position 3, which is xsd:dateTime - a Maybe union matches its datatype exactly" .

ex:badExampleTupleIntegerInIntPosition
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalNumbers ;
  qudt:values ( true 23.7 2.37e1 "23.7"^^xsd:float 42 42 "42"^^xsd:long "42"^^xsd:nonNegativeInteger ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "42 (xsd:integer) in position 6, which is xsd:int - a Maybe union matches its datatype exactly" .

ex:badExampleTupleKindElementType
  a qudt:NTupleKind ;
  dcterms:description """
  <p>A tuple kind with member specs that also gives a shared qudt:elementType. A tuple kind describes
  its positions only through its member specs (qudt:HeterogeneousCellsShape).</p>"""^^rdf:HTML ;
  qudt:elementType xsd:string ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:string ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:string ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "Invalid tuple kind - member specs and a shared element type" .

ex:badExampleTupleNothingInRequiredPosition
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_Measurement ;
  qudt:values ( "2026-05-12"^^xsd:date ( ) unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "rdf:nil in position 2, which requires xsd:decimal - only a Maybe union admits Nothing" .

ex:badExampleTupleTimeInAnyDatePosition
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalAnyDate ;
  qudt:values ( "2026-05-12"^^xsd:date "14:30:00"^^xsd:time "2026"^^xsd:gYear "--05"^^xsd:gMonth ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "xsd:time in position 2 - qudt:DateUnionType covers date, dateTime, gYear and gMonth only" .

ex:cpaBadLengthShort
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 31 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "only 2 members - violates LIST [3:4] (too short)" .

ex:cpaBadMicroseconds
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 31 12 1000000 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "millionth-seconds = 1000000 - violates MicrosecondsInRange" .

ex:cpaBadMinutes
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 60 0 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "minutes = 60 - violates MinutesInRange" .

ex:cpaBadSeconds
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 31 75 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "seconds = 75 - violates SecondsInRange" .

ex:cpaBadSign
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 -31 12 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "mixed signs - violates ConsistentSign" .

ex:cpaBadType
  a ex:IfcCompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IfcCompoundPlaneAngleMeasure ;
  qudt:values ( 52 31 "12" ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  rdfs:label "seconds is a string - violates the integer member type" .

vaem:GMD_INVALID-TUPLE-DATATYPES
  a vaem:GraphMetaData ;
  dcterms:description """
  Invalid examples of tuples, tuple kinds and tuple member specs, among them the IFC compound plane
  angle measure. Each breaks a constraint of the SHACL datatype schema.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:label "QUDT Examples of Invalid Tuple Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple/invalid> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Invalid Tuple Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


