      quantitykind:LinearVelocity
      quantitykind:LinearVelocity
    ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Drone vector of 3D velocity values" ;
.
