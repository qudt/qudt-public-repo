ex:TABLE_2x4
  a qudt:Table ;
  qudt:byRow true ;
  qudt:columns 4 ;
  qudt:dimensionality 2 ;
  qudt:dimensions (
      2
      4
    ) ;
  qudt:rows 2 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Table 2x4" ;
.
ex:Vector3D_FLOAT-DP
  a qudt:Vector ;
  qudt:datatype datatype:FLOAT-DP ;
  qudt:dimensionality 1 ;
  qudt:dimensions (
      3
    ) ;
