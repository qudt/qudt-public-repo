  qudt:dimensions ( 2 2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a State space matrix 2 by 2 Double Precision" .

ex:StateSpaceMatrix-2by4-FLOATDP
  a qudt:StateSpaceMatrix ;
