  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Vector kind - Drone Velocity" .

ex:VectorKind_GeoPosition
  a qudt:VectorKind ;
  dcterms:description """
  <p>A heterogeneous vector kind with three components; the per-component types are given by its
  own <code>qudt:tupleMemberSpecs</code>.</p>"""^^rdf:HTML ;
  qudt:elementCount 3 ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:Angle ;
    qudt:hasUnit unit:DEG ;
    qudt:index 1 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:Angle ;
    qudt:hasUnit unit:DEG ;
    qudt:index 2 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:Altitude ;
    qudt:hasUnit unit:M ;
    qudt:index 3 ;
    sh:datatype xsd:integer ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Geographic position vector kind" .

ex:VectorKind_MassProperties
  a qudt:VectorKind ;
  dcterms:description """
  <p>A heterogeneous vector kind with six components; the per-component types, quantity kinds and
  units are given by its own <code>qudt:tupleMemberSpecs</code>.
  </p>"""^^rdf:HTML ;
  qudt:elementCount 6 ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:CenterOfGravity_X ;
    qudt:hasUnit unit:M ;
    qudt:index 1 ;
    sh:datatype xsd:double ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:CenterOfGravity_Y ;
    qudt:hasUnit unit:M ;
    qudt:index 2 ;
    sh:datatype xsd:double ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:CenterOfGravity_Z ;
    qudt:hasUnit unit:M ;
    qudt:index 3 ;
    sh:datatype xsd:double ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:Mass ;
    qudt:hasUnit unit:KiloGM ;
    qudt:index 4 ;
    sh:datatype xsd:double ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:MomentOfInertia ;
    qudt:hasUnit unit:KiloGM-M2 ;
    qudt:index 5 ;
    sh:datatype xsd:double ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:hasQuantityKind quantitykind:PRODUCT-OF-INERTIA ;
    qudt:hasUnit unit:KiloGM-M2 ;
    qudt:index 6 ;
    sh:datatype xsd:double ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Mass properties vector kind" .

ex:Vector_DroneVelocities_3D
  a qudt:Vector ;
  dcterms:description """
  <p>A 3D velocity vector has values for x, y and z directionality"
  </p>"""^^rdf:HTML ;
  qudt:datatypeKind ex:VectorKind_DroneVelocity ;
  qudt:values ( 12.5 -3.2 0.8 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Drone vector of 3D velocity values" .

ex:Vector_GeoPosition
  a qudt:Vector ;
  dcterms:description """
  <p>A heterogeneous vector giving a geographic position: latitude and longitude in degrees as
  decimals, and altitude in whole metres as an integer. The component types are given by
  <code>ex:VectorKind_GeoPosition</code>.</p>"""^^rdf:HTML ;
  qudt:datatypeKind ex:VectorKind_GeoPosition ;
  qudt:values ( 51.4779 -0.0015 46 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Geographic position vector" .

ex:Vector_MassProperties
  a qudt:Vector ;
  qudt:datatypeKind ex:VectorKind_MassProperties ;
  qudt:values ( 0.1E0 0.5E0 1.0E0 2.0E0 3.0E0 4.0E0 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Mass Properties Vector Example" .

