@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix datatype: <http://qudt.org/vocab/datatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/datatype>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/array> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:label "QUDT Examples of Datatypes v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_EXAMPLE-DATATYPES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:Enumeration_RoomTemperatureAlarm
  a qudt:Enumeration ;
  qudt:element ex:HighAlarm ;
  qudt:element ex:LowAlarm ;
  qudt:element ex:NoAlarm ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Room Temperature Alarm Enumeration" .

ex:HighAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "High Alarm" .

ex:List_3_Decimal
  a qudt:List ;
  dcterms:description "Example of a list of 3 decimal values." ;
  qudt:datatype datatype:DECIMAL ;
  qudt:value ( 54.0 55.6 56.9 61.2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a list of 3 decimal values" .

ex:List_3_Strings
  a qudt:List ;
  dcterms:description """
  <p>TBD
  </p>"""^^rdf:HTML ;
  qudt:datatype datatype:UTF8-STRING ;
  qudt:value ( "one" "two" "three" ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a List of 3 strings" .

ex:LowAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Low Alarm" .

ex:NoAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "No Alarm" .

ex:Quantity_CarSpeed
  a qudt:Quantity ;
  dcterms:description """
  <p>The value of a car speed is stated as <em>90 KiloMetres/Hour</em>.
  Which car this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:hasQuantityKind quantitykind:LinearVelocity ;
  qudt:hasUnit unit:KiloM-PER-HR ;
  qudt:value 90.0 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Car Speed" .

ex:Quantity_DroneVelocity
  a qudt:Quantity ;
  dcterms:description """
  <p>In this example a drone velocity is stated as a single value without any consideration for x, y, and z directions.
  The quantity kind, unit of measure and value are held on the quantity.
  Which drone this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:hasQuantityKind quantitykind:LinearVelocity ;
  qudt:hasUnit unit:M-PER-SEC ;
  qudt:value 10.0 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Drone Velocity" .

ex:Quantity_DroneVelocity3D
  a qudt:Quantity ;
  dcterms:description """
  <p>In this example a drone velocity is stated as a 3D vector for the x, y, and z directions.
  In this case the vector holds the 3 values along with the quantity-kinds and units.
  Which drone this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:value ex:Vector_DroneVelocities_3D ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Drone Velocity 3D" .

ex:Quantity_RoomTemperature
  a qudt:Quantity ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_F ;
  qudt:value ex:List_3_Decimal ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Room Temperature" .

ex:Quantity_RoomTemperature_AlarmState
  a qudt:Quantity ;
  qudt:value ex:LowAlarm ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Room Temperature Alarm State" .

vaem:GMD_EXAMPLE-DATATYPES
  a vaem:GraphMetaData ;
  dcterms:description """
  This QUDT 'Datatype' vocabulary provides examples of scalar datatypes, lists, enumerations and quantities.
  The tuple examples are in <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple>, and the array and
  vector examples in <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/array>.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:label "QUDT Examples of Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


