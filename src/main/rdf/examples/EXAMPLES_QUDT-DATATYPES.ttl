ex:StatusFlagTupleSpec
  a qudt:NTupleSpec ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:boolean ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

ex:TABLE_2x4
  a qudt:TableType ;
  qudt:byRow true ;
  qudt:columns 4 ;
  qudt:dimensionality 2 ;
  qudt:dimensions ( 2 4 ) ;
  qudt:rows 2 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Table 2x4" .

ex:TempPressureArraySpec
  a qudt:NTupleSpec ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:string ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 3 ;
    sh:class qudt:Unit ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 4 ;
    sh:datatype xsd:string ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 5 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 6 ;
    sh:class qudt:Unit ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Element-type spec for the 2x3 heterogeneous array" .

ex:Vector3D_FLOAT-DP
  a qudt:Vector ;
  qudt:datatype datatype:FLOAT-DP ;
  qudt:dimensionality 1 ;
  qudt:dimensions ( 3 ) ;
  qudt:value ( 1.1 2.2 3.3 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a 3D Vector - double precision" .

ex:Vector3D_FLOAT-SP
  a qudt:Vector ;
  qudt:datatype datatype:FLOAT-SP ;
  qudt:dimensionality 1 ;
  qudt:dimensions ( 3 ) ;
  qudt:value ( 1.1 2.2 3.3 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a 3D vector - single precision" .

ex:Vector_DroneVelocities_3D
  a qudt:Vector ;
  dcterms:description """
  <p>A 3D velocity vector has values for x, y and z directionality"
  </p>"""^^rdf:HTML ;
  qudt:datatype datatype:DECIMAL ;
  qudt:dimensionality 1 ;
  qudt:dimensions ( 3 ) ;
  qudt:hasQuantityKindsList ( quantitykind:LinearVelocity quantitykind:LinearVelocity
    quantitykind:LinearVelocity ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Drone vector of 3D velocity values" .

ex:exampleQuantityValueTuple
  a qudt:NTuple ;
  qudt:conformsToTupleSpec ex:QuantityValueUnitTupleSpec ;
  qudt:values ( quantitykind:Temperature 23.7 unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

ex:exampleTuple1
  a qudt:NTuple ;
  qudt:conformsToTupleSpec ex:DateCountTupleSpec ;
  qudt:values ( "2026-05-12"^^xsd:date 42 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

ex:exampleTuple2
  a qudt:NTuple ;
  qudt:conformsToTupleSpec ex:StatusFlagTupleSpec ;
  qudt:values ( "Approved" true ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

ex:exampleTuple3
  a qudt:NTuple ;
  qudt:conformsToTupleSpec ex:MeasurementTupleSpec ;
  qudt:values ( "2026-05-12"^^xsd:date 23.7 unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

ex:exampleTuple5
  a qudt:NTuple ;
  qudt:conformsToTupleSpec ex:ResourceLabelRatingTupleSpec ;
  qudt:values ( quantitykind:Temperature "Ambient temperature"@en 5 unit:DEG_C
    "2026-05-12"^^xsd:date ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .


