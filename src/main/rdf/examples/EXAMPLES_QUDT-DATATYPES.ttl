  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> .

