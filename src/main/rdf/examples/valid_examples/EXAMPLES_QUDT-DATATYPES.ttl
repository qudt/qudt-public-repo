@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix datatype: <http://qudt.org/vocab/datatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix ex: <http://example.org#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/datatype>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "QUDT Examples of Datatypes v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_EXAMPLE-DATATYPES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

ex:OffOnStateTypeEnumeration
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A discrete state enumeration whose values are 'off' and 'on'. 
  The 'off' value is encoded as a zero (0) and the 'on' value as a one (1).
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:subClassOf qudt:Enumeration .

ex:OnOffStateType
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "On off state type" ;
  rdfs:subClassOf qudt:DiscreteState .

ex:OnOffStateTypeEnumeration
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A discrete state enumeration whose values are 'off' and 'on'. 
  The 'on' value is encoded as a zero (0) and the 'off' value as a one (1).
  """ ;
  qudt:inverted true ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:subClassOf qudt:Enumeration .

ex:WetDryStateType
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Wet dry state type" ;
  rdfs:subClassOf qudt:DiscreteState ;
  rdfs:subClassOf qudt:EnumeratedValue .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:Enumeration_RoomTemperatureAlarm
  a qudt:Enumeration ;
  qudt:element ex:HighAlarm ;
  qudt:element ex:LowAlarm ;
  qudt:element ex:NoAlarm ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Room Temperature Alarm Enumeration" .

ex:HighAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "High Alarm" .

ex:List_3_Decimal
  a qudt:List ;
  dcterms:description "Example of a list of 3 decimal values." ;
  qudt:datatype datatype:DECIMAL ;
  qudt:value ( 54.0 55.6 56.9 61.2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a list of 3 decimal values" .

ex:List_3_Strings
  a qudt:List ;
  dcterms:description """
  <p>TBD
  </p>"""^^rdf:HTML ;
  qudt:datatype datatype:UTF8-STRING ;
  qudt:value ( "one" "two" "three" ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Example of a List of 3 strings" .

ex:LowAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Low Alarm" .

ex:NoAlarm
  a qudt:EnumeratedValue ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "No Alarm" .

ex:OFF
  a ex:OnOffStateType ;
  dtype:code "0" ;
  dtype:literal "off" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Off" .

ex:OFFstate
  a ex:OffOnStateTypeEnumeration ;
  dtype:code "0" ;
  dtype:literal "off" ;
  qudt:element ex:OFF ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Off" .

ex:ON
  a ex:OnOffStateType ;
  dtype:code "1" ;
  dtype:literal "on" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "On" .

ex:ONstate
  a ex:OnOffStateTypeEnumeration ;
  dtype:code "1" ;
  dtype:literal "on" ;
  qudt:element ex:ON ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "On" .

ex:OneMeansOff
  a ex:OnOffStateType ;
  dtype:literal "off" ;
  qudt:inverted true ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "One means off" .

ex:WDST_DRY
  a ex:WetDryStateType ;
  dtype:code "2" ;
  dtype:literal "dry" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Dry" .

ex:WDST_WET
  a ex:WetDryStateType ;
  dtype:code "1" ;
  dtype:literal "wet" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "Wet" .

vaem:GMD_EXAMPLE-DATATYPES
  a vaem:GraphMetaData ;
  dcterms:description """
  This QUDT 'Datatype' vocabulary provides examples of scalar datatypes, lists, enumerations and discrete states.
  The tuple examples are in <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple>, the array and
  vector examples in <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/array>, and the quantity
  examples in <http://qudt.org/$$QUDT_VERSION$$/examples/quantities>.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  rdfs:label "QUDT Examples of Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


