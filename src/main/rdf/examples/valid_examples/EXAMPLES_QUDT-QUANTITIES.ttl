@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/quantities>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/examples/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/array> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "QUDT Examples of Quantities v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_QUANTITIES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:Quantity_CarSpeed
  a qudt:Quantity ;
  dcterms:description """
  <p>The value of a car speed is stated as <em>90 KiloMetres/Hour</em>.
  Which car this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:hasQuantityKind quantitykind:LinearVelocity ;
  qudt:hasUnit unit:KiloM-PER-HR ;
  qudt:value 90.0 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "Car Speed" .

ex:Quantity_DroneVelocity
  a qudt:Quantity ;
  dcterms:description """
  <p>In this example a drone velocity is stated as a single value without any consideration for x, y, and z directions.
  The quantity kind, unit of measure and value are held on the quantity.
  Which drone this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:hasQuantityKind quantitykind:LinearVelocity ;
  qudt:hasUnit unit:M-PER-SEC ;
  qudt:value 10.0 ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "Drone Velocity" .

ex:Quantity_DroneVelocity3D
  a qudt:Quantity ;
  dcterms:description """
  <p>In this example a drone velocity is stated as a 3D vector for the x, y, and z directions.
  In this case the vector holds the 3 values along with the quantity-kinds and units.
  Which drone this refers to is out-of-scope for the example, a link such as <i>has speed</i> would be
   one way to reference this quantity.
  </p>"""^^rdf:HTML ;
  qudt:value ex:Vector_DroneVelocities_3D ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "Drone Velocity 3D" .

ex:Quantity_RoomTemperature
  a qudt:Quantity ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_F ;
  qudt:value ex:List_3_Decimal ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "Room Temperature" .

ex:Quantity_RoomTemperature_AlarmState
  a qudt:Quantity ;
  qudt:value ex:LowAlarm ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "Room Temperature Alarm State" .

vaem:GMD_QUANTITIES
  a vaem:GraphMetaData ;
  dcterms:description """
  Examples of quantities (qudt:Quantity) whose values are of different datatypes: a number, a list, an
  enumerated value and a vector.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  rdfs:label "QUDT Examples of Quantities - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/quantities> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Quantities - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
