    qudt:index 1 ;
    sh:class qudt:QuantityKind ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
