  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:boolean ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:Tuple1_Date
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_DateCount ;
  qudt:values ( "2026-05-12"^^xsd:date 42 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Date Tuple Example" .

ex:Tuple2_ApprovedTrue
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_StatusFlag ;
  qudt:values ( "Approved" true ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Approved True 2-Tuple Example" .

ex:Tuple2_TemperatureInDegreesC
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_QuantityValueUnit ;
  qudt:values ( quantitykind:Temperature 23.7 unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Temperature in Degrees C Example" .

ex:Tuple3_DatedTemperatureInDegreesC
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_Measurement ;
  qudt:values ( "2026-05-12"^^xsd:date 23.7 unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Dated Temperature in Degrees C Example" .

ex:Tuple5_DatedAndLabelledTemperatureInDegreesC
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_ResourceLabelRating ;
  qudt:values ( quantitykind:Temperature "Ambient temperature"@en 5 unit:DEG_C
    "2026-05-12"^^xsd:date ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Dated and Labelled Temperature in Degrees C Example" .

ex:cpaBerlinLatitude
  a ex:IFCcompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IFCcompoundPlaneAngleMeasure ;
  qudt:values ( 52 31 12 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "52 deg 31 min 12 sec N latitude (3-part form, no millionth-seconds)" .

ex:cpaExactDegrees
  a ex:IFCcompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IFCcompoundPlaneAngleMeasure ;
  qudt:values ( 45 0 0 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "exactly 45 degrees" .

ex:cpaLongitudeExample
  a ex:IFCcompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IFCcompoundPlaneAngleMeasure ;
  qudt:values ( 13 24 18 500000 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "13 deg 24 min 18.5 sec E longitude (4-part)" .

ex:cpaRefLatitudeExample
  a ex:IFCcompoundPlaneAngleMeasure ;
  qudt:datatypeKind ex:NTupleKind_IFCcompoundPlaneAngleMeasure ;
  qudt:values ( -50 -58 -33 -110400 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "-50 deg 58 min 33.110400 sec (the IFC spec worked example, 4-part, all negative)" .

ex:exampleTupleOptionalAnyDateJust
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalAnyDate ;
  qudt:values ( "2026-05-12"^^xsd:date "2026-05-12T14:30:00"^^xsd:dateTime "2026"^^xsd:gYear
    "--05"^^xsd:gMonth ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalAnyDateMixed
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalAnyDate ;
  qudt:values ( "2026-05-12"^^xsd:date ( ) "2026"^^xsd:gYear ( ) ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalBinaryJust
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalBinary ;
  qudt:values ( "0FB7"^^xsd:hexBinary "D7c="^^xsd:base64Binary ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalBinaryMixed
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalBinary ;
  qudt:values ( "0FB7"^^xsd:hexBinary ( ) ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalIntegersJust
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalIntegers ;
  qudt:values ( "42"^^xsd:positiveInteger "-42"^^xsd:negativeInteger "-42"^^xsd:nonPositiveInteger
    "42"^^xsd:short "42"^^xsd:byte "42"^^xsd:unsignedLong "42"^^xsd:unsignedInt
    "42"^^xsd:unsignedShort "42"^^xsd:unsignedByte ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalIntegersMixed
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalIntegers ;
  qudt:values ( "42"^^xsd:positiveInteger ( ) "-42"^^xsd:nonPositiveInteger ( ) "42"^^xsd:byte ( )
    "42"^^xsd:unsignedInt ( ) "42"^^xsd:unsignedByte ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalNumbersJust
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalNumbers ;
  qudt:values ( true 23.7 2.37e1 "23.7"^^xsd:float 42 "42"^^xsd:int "42"^^xsd:long
    "42"^^xsd:nonNegativeInteger ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalNumbersMixed
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalNumbers ;
  qudt:values ( true ( ) 2.37e1 ( ) 42 ( ) "42"^^xsd:long ( ) ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalTemporalJust
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalTemporal ;
  qudt:values ( "2026-05-12"^^xsd:date "14:30:00"^^xsd:time "2026-05-12T14:30:00"^^xsd:dateTime
    "2026-05-12T14:30:00Z"^^xsd:dateTimeStamp "2026"^^xsd:gYear "--05"^^xsd:gMonth "---12"^^xsd:gDay
    "2026-05"^^xsd:gYearMonth "--05-12"^^xsd:gMonthDay "P1Y2M3DT4H"^^xsd:duration
    "P3DT4H"^^xsd:dayTimeDuration "P1Y2M"^^xsd:yearMonthDuration ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:exampleTupleOptionalTemporalMixed
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalTemporal ;
  qudt:values ( "2026-05-12"^^xsd:date ( ) "2026-05-12T14:30:00"^^xsd:dateTime ( ) "2026"^^xsd:gYear
    ( ) "---12"^^xsd:gDay ( ) "--05-12"^^xsd:gMonthDay ( ) "P3DT4H"^^xsd:dayTimeDuration ( ) ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

vaem:GMD_TUPLE-DATATYPES
  a vaem:GraphMetaData ;
  dcterms:description """
  Examples of tuple datatypes: tuple kinds (qudt:NTupleKind) and the tuples (qudt:NTuple) that point at them,
  including tuples with optional positions, and the IFC compound plane angle measure
  (IfcCompoundPlaneAngleMeasure) modelled as a tuple.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "QUDT Examples of Tuple Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Tuple Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


