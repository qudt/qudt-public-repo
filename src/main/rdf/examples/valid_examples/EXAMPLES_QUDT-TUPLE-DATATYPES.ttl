  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:NTupleKind_ResourceLabelRating
  a qudt:NTupleKind ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:nodeKind sh:IRI ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 3 ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 5 ;
    sh:minInclusive 1 ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 4 ;
    sh:class qudt:Unit ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 5 ;
    sh:datatype xsd:date ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

