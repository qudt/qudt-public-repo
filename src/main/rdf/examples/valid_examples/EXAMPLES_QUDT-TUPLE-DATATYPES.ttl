@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "QUDT Examples of Tuple Datatypes v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_TUPLE-DATATYPES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

ex:IFCcompoundPlaneAngleMeasure
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "IFC Compound Plane Angle Measure" ;
  rdfs:subClassOf qudt:NTuple ;
  sh:sparql ex:IFCcompoundPlaneAngleConsistentSign .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:IFCcompoundPlaneAngleConsistentSign
  a sh:SPARQLConstraint ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  sh:message "Compound plane angle has components of mixed sign (ConsistentSign)." ;
  sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype> ;
  sh:select """
      SELECT $this WHERE {
          $this qudt:values ?values .
          ?values rdf:rest*/rdf:first ?a .
          ?values rdf:rest*/rdf:first ?b .
          FILTER ( ?a > 0 && ?b < 0 )
      }
  """ .

ex:MaybeTuple2_JustValues
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalReading ;
  qudt:values ( "2026-05-12"^^xsd:date 23.7 unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Temperature in Degrees C Maybe Example" .

ex:MaybeTuple2_NilValue
  a qudt:NTuple ;
  qudt:datatypeKind ex:NTupleKind_OptionalReading ;
  qudt:values ( "2026-05-12"^^xsd:date ( ) unit:DEG_C ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "Temperature in Degrees C Maybe Example - no value" .

ex:NTupleKind_DateCount
  a qudt:NTupleKind ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:date ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

ex:NTupleKind_IFCcompoundPlaneAngleMeasure
  a qudt:NTupleKind ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:integer ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:integer ;
    sh:maxExclusive 60 ;
    sh:minExclusive -60 ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 3 ;
    sh:datatype xsd:integer ;
    sh:maxExclusive 60 ;
    sh:minExclusive -60 ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 4 ;
    sh:datatype xsd:integer ;
    sh:maxExclusive 1000000 ;
    sh:minCount 0 ;
    sh:minExclusive -1000000 ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> ;
  rdfs:label "IfcCompoundPlaneAngleMeasure: (degrees, minutes, seconds, [millionth-seconds])" .

ex:NTupleKind_Measurement
  a qudt:NTupleKind ;
  qudt:tupleMemberSpecs ( [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 1 ;
    sh:datatype xsd:date ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 2 ;
    sh:datatype xsd:decimal ;
  ] [
    a qudt:NTupleMemberTypeSpec ;
    qudt:index 3 ;
    sh:class qudt:Unit ;
  ] ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/tuple> .

