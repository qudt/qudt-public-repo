@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .

<http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection>
  a owl:Ontology ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/qudt> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/datatype> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "QUDT Examples of Collection Datatypes v$$QUDT_VERSION$$" ;
  vaem:hasGraphMetadata vaem:GMD_COLLECTION-DATATYPES ;
  vaem:hasGraphRole vaem:VocabularyGraph .

dcterms:contributor
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "contributor" ;
  rdfs:range xsd:string .

dcterms:creator
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "creator" ;
  rdfs:range xsd:string .

dcterms:description
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "description" ;
  rdfs:range xsd:string .

dcterms:rights
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "rights" ;
  rdfs:range xsd:string .

dcterms:subject
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "subject" ;
  rdfs:range xsd:string .

dcterms:title
  a owl:AnnotationProperty ;
  rdfs:isDefinedBy dcterms: ;
  rdfs:label "title" ;
  rdfs:range xsd:string .

ex:CollectionKind_AnyIRI
  a qudt:CollectionKind ;
  dcterms:description """
  <p>A collection kind whose members may be any IRI, given as an element spec with sh:nodeKind sh:IRI.</p>"""^^rdf:HTML ;
  qudt:elementSpec [
    sh:nodeKind sh:IRI ;
  ] ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Collection kind of IRIs" .

ex:CollectionKind_EnglishLabels
  a qudt:CollectionKind ;
  dcterms:description """
  <p>A collection kind of English labels: language-tagged strings, refined with sh:languageIn ( "en" ),
  which also accepts regional tags such as en-GB.</p>"""^^rdf:HTML ;
  qudt:elementSpec [
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" ) ;
  ] ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Collection kind of English labels" .

ex:CollectionKind_Temperatures
  a qudt:CollectionKind ;
  dcterms:description """
  <p>Blueprint for collections of room temperatures: every member is an xsd:decimal temperature in
  degrees Fahrenheit. It gives no number of members.</p>"""^^rdf:HTML ;
  qudt:elementType xsd:decimal ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_F ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Collection kind of temperatures in degrees Fahrenheit" .

ex:MapKind_FloorTemperatures
  a qudt:MapKind ;
  dcterms:description """
  <p>Blueprint for maps from floor numbers to temperatures. A floor number may be of any numeric
  datatype, which a single IRI cannot say, so the key type is given with qudt:keySpec.</p>"""^^rdf:HTML ;
  qudt:elementType xsd:decimal ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_C ;
  qudt:keySpec [
    sh:or qudt:NumericUnionType ;
  ] ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Map kind from floor numbers to temperatures in degrees Celsius" .

ex:MapKind_RoomTemperatures
  a qudt:MapKind ;
  dcterms:description """
  <p>Blueprint for maps from room names to temperatures: every key is an xsd:string, and every value an
  xsd:decimal temperature in degrees Fahrenheit.</p>"""^^rdf:HTML ;
  qudt:elementType xsd:decimal ;
  qudt:hasQuantityKind quantitykind:Temperature ;
  qudt:hasUnit unit:DEG_F ;
  qudt:keyType xsd:string ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Map kind from room names to temperatures in degrees Fahrenheit" .

ex:Map_FloorTemperatures
  a qudt:Map ;
  qudt:datatypeKind ex:MapKind_FloorTemperatures ;
  qudt:keys ( 0 1 2.5 3.0E0 ) ;
  qudt:values ( 19.5 20.0 21.0 21.5 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Temperatures by floor" .

ex:Map_RoomTemperatures
  a qudt:Map ;
  dcterms:description """
  <p>The temperature of each room: the key at each position of qudt:keys maps to the value at the same
  position of qudt:values, so the kitchen is at 68.0 degrees Fahrenheit.</p>"""^^rdf:HTML ;
  qudt:datatypeKind ex:MapKind_RoomTemperatures ;
  qudt:keys ( "Kitchen" "Lounge" "Study" ) ;
  qudt:values ( 68.0 70.5 66.2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Room temperatures by room" .

ex:MultiSet_DailyHighs
  a qudt:MultiSet ;
  dcterms:description """
  <p>Daily high temperatures over four days. Two days had the same high, which a multiset (bag) allows.</p>"""^^rdf:HTML ;
  qudt:datatypeKind ex:CollectionKind_Temperatures ;
  qudt:values ( 61.2 63.5 61.2 59.0 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Daily high temperatures" .

ex:Set_RelatedResources
  a qudt:Set ;
  qudt:datatypeKind ex:CollectionKind_AnyIRI ;
  qudt:values ( ex:Set_RoomTemperatures ex:MultiSet_DailyHighs ex:Map_RoomTemperatures ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Related temperature collections" .

ex:Set_RoomLabels
  a qudt:Set ;
  qudt:datatypeKind ex:CollectionKind_EnglishLabels ;
  qudt:values ( "Kitchen"@en "Lounge"@en-GB "Study"@en ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Room labels" .

ex:Set_RoomTemperatures
  a qudt:Set ;
  dcterms:description """
  <p>A set of four distinct room temperatures. Its kind gives the members' type, quantity kind and unit,
  so the set itself holds only the values.</p>"""^^rdf:HTML ;
  qudt:datatypeKind ex:CollectionKind_Temperatures ;
  qudt:values ( 54.0 55.6 56.9 61.2 ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "Room temperatures" .

vaem:GMD_COLLECTION-DATATYPES
  a vaem:GraphMetaData ;
  dcterms:description """
  Examples of collection datatypes: a collection kind (qudt:CollectionKind) and the collections, a set and a
  multiset, that point at it.
  """^^rdf:HTML ;
  dcterms:modified "1234-12-12T12:34:56Z"^^xsd:dateTime ;
  dcterms:subject "Datatypes" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  rdfs:label "QUDT Examples of Collection Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:hasGraphRole vaem:VocabularyGraph ;
  vaem:isMetadataFor <http://qudt.org/$$QUDT_VERSION$$/examples/datatype/collection> ;
  vaem:logo "https://qudt.org/linkedmodels.org/assets/lib/lm/images/logos/qudt_logo-300x110.png"^^xsd:anyURI ;
  vaem:name "QUDT" ;
  vaem:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
  vaem:namespacePrefix "qudt" ;
  vaem:owner "QUDT.ORG" ;
  vaem:title "QUDT Examples of Collection Datatypes - Version $$QUDT_VERSION$$" ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:creator ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:rights ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource <http://voag.linkedmodel.org/voag#QUDT-Attribution> ;
  vaem:withAttributionTo <http://voag.linkedmodel.org/voag#QUDT-Attribution> .


