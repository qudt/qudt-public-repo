@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix datatype: <http://qudt.org/vocab/datatype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sou: <http://qudt.org/vocab/sou/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/schema/voag#> .

<http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured>
  a owl:Ontology ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  owl:imports sh: ;
  owl:imports <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/scalar> ;
  rdfs:label "QUDT SHACL SCHEMA Structured Datatypes Version $$QUDT_VERSION$$" ;
  sh:declare [
    sh:namespace "http://qudt.org/schema/qudt/"^^xsd:anyURI ;
    sh:prefix "qudt" ;
  ] ;
  sh:declare [
    sh:namespace "http://qudt.org/vocab/quantitykind/"^^xsd:anyURI ;
    sh:prefix "quantitykind" ;
  ] ;
  sh:declare [
    sh:namespace "http://qudt.org/vocab/unit/"^^xsd:anyURI ;
    sh:prefix "unit" ;
  ] ;
  sh:declare [
    sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    sh:prefix "rdf" ;
  ] ;
  sh:declare [
    sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    sh:prefix "rdfs" ;
  ] ;
  sh:declare [
    sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ;
    sh:prefix "sh" ;
  ] ;
  vaem:hasCatalogEntry voag:QUDT-SchemaCatalogEntry ;
  vaem:hasGraphMetadata vaem:GMD_SCHEMA-SHACL-DATATYPE-STRUCTURED ;
  vaem:hasGraphRole vaem:SchemaGraph ;
  vaem:intent "This ontology is to be used by other ontologies that need structured datatype definitions." ;
  vaem:specificity 1 ;
  vaem:url "http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured"^^xsd:anyURI .

qudt:AbstractDatatype
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An <em>Abstract Datatype</em> (ADT) is a specification of a set of data and the set of operations that can be performed on the data. 
  Such a data type is abstract in the sense that it is independent of various concrete implementations. 
  The definition can be mathematical, or it can be programmed as an interface. 
  A first class ADT supports the creation of multiple instances of the ADT, and the interface normally provides a constructor,
   which returns an abstract handle to new data, and several operations, 
   which are functions accepting the abstract handle as an argument.</p>
  """^^rdf:HTML ;
  prov:wasInfluencedBy <http://en.wikipedia.org/wiki/Abstract_data_type> ;
  prov:wasInfluencedBy <http://xlinux.nist.gov/dads/HTML/abstractDataType.html> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Abstract Datatype" ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:AlgebraicDatatype
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """<p>An <em>Algebraic Datatype</em> is a datatype each of whose values are data from other data types wrapped in one of the constructors of the data type. 
Any wrapped datum is an argument to the constructor. 
In contrast to other data types, the constructor is not executed and the only way to operate on the data is to unwrap the constructor using pattern matching.
</p>
<p>The most common algebraic data type is a list with two constructors: Nil or [] for an empty list, and Cons (an abbreviation of constructor), 
 ::, or : for the combination of a new element with a shorter list (for example (Cons 1 '(2 3 4)) or 1:[2,3,4]).
</p>
<p>Special cases of algebraic types are product types i.e. records (only one constructor) and enumerated types (many constructors with no arguments). 
Algebraic types are one kind of composite type (i.e. a type formed by combining other types).
</p>
<p>An algebraic data type may also be an abstract data type (ADT) if it is exported from a module without its constructors. 
Values of such a type can only be manipulated using functions defined in the same module as the type itself.
</p>"""^^rdf:HTML ;
  prov:wasInfluencedBy <http://en.wikipedia.org/wiki/Algebraic_data_type> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Algebraic Datatype" ;
  rdfs:seeAlso qudt:AbstractDatatype ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:AlignmentType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  Specifies how a physical data field is aligned. 
  The alignment could be at a bit, byte or word boundary.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Alignment type" ;
  rdfs:subClassOf qudt:EnumeratedValue ;
  sh:in ( datatype:BitAligned datatype:ByteAligned datatype:WordAligned ) .

qudt:Array
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. 
  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.
  </p>
  <p>The key considerations for an Array are:
  </p>
  <ol>
  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>
  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>
  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>
  </ol>
  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.
  The number of dimensions is specified in the attribute 'dimensionality'.
  </p>
  <p>An array can be multi-dimensional.
  Multiple indices are used but they are treated as extensions of the same structure.
  For example, for a 2D array arr[2][3], the indices refer to the row and column positions.
  </p>
  <p>The values of an array are held in a single flat list (the property 'qudt:values').
  By default the innermost (last) index varies fastest: the values sharing the same outer indices
  occur contiguously before the outer index advances, so the values of the first dimension occur
  first, followed by the values of the next dimension, and so on. Higher dimensional arrays follow
  the same pattern for each additional dimension. For a 2D array arr[2][3] the default order is:
  </p>
  <pre>arr[0][0] arr[0][1] arr[0][2]  arr[1][0] arr[1][1] arr[1][2]</pre>
  <p>An instance may override this default ordering by stating a 'qudt:dataOrder'
  (see 'qudt:ArrayDataOrder' for the available orderings).
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Array" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:ValuesList ;
  sh:property qudt:Array-datatypeKind ;
  sh:sparql qudt:ValuesListLengthCheck ;
  sh:sparql qudt:ValuesListElementTypeCheck ;
  .

qudt:Array-datatypeKind
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:class qudt:ArrayKind ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:path qudt:datatypeKind .

qudt:ArrayKind
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An <em>Array Kind</em> is the blueprint for an array value. It describes the shape and
  element types of an array without holding any data: the rank
  (<code>qudt:dimensionality</code>), the extent of each dimension
  (<code>qudt:dimensions</code>), the total number of cells
  (<code>qudt:elementCount</code>), the linearisation of the value list
  (<code>qudt:dataOrder</code>), and the element type.
  </p>
  <p>The values themselves live on the <code>qudt:Array</code> instance, which points at its kind
  with <code>qudt:datatypeKind</code>. One kind may therefore be shared by many arrays, which is
  the reason the description is held separately from the data.
  </p>
  <p>Element types are given one of two ways. A homogeneous array kind declares a single shared
  <code>qudt:elementType</code>, together with any quantity kind or unit shared by every cell. A
  heterogeneous array kind instead points, via <code>qudt:conformsToTupleSpec</code>, at a
  <code>qudt:NTupleSpec</code> that gives one type per position, addressed 1-based over the flat
  value list.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Array Kind" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:ArrayKind-dataOrder ;
  sh:property qudt:ArrayKind-isHeterogeneous ;
  sh:property qudt:ArrayKind-elementType ;
  sh:property qudt:ArrayKind-elementCount ;
  sh:property qudt:ArrayKind-conformsToTupleSpec ;
  sh:property qudt:DimensionalityPropertyShape ;
  sh:property qudt:DimensionsPropertyShape ;
  sh:sparql qudt:ArrayRankCheck .

qudt:ArrayKind-dataOrder
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:class qudt:ArrayDataOrder ;
  sh:maxCount 1 ;
  sh:path qudt:dataOrder .

qudt:ArrayKind-isHeterogeneous
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:datatype xsd:boolean ;
  sh:maxCount 1 ;
  sh:path qudt:isHeterogeneous .

qudt:ArrayKind-elementType
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:description """
  For Homogeneous arrays, the single shared element-type facet (a datatype or a class IRI). 
  Heterogeneous arrays instead use qudt:conformsToTupleSpec.
  """ ;
  sh:path qudt:elementType ;
  sh:nodeKind sh:IRI ;
  sh:maxCount 1 .

qudt:ArrayKind-elementCount
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:description """
  The total number of cells = product of the dimensions. 
  Held explicitly because SPARQL has no PRODUCT aggregate.
  ArrayLengthCheck compares it against the length of the flat value list.
  """ ;
  sh:path qudt:elementCount ;
  sh:datatype xsd:integer ;
  sh:minInclusive 0 ;
  sh:maxCount 1 .

qudt:ArrayKind-conformsToTupleSpec
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:description """
  Used by heterogeneous arrays for per-position element types, reusing the N-Tuple
  blueprint (qudt:NTupleSpec), addressed 1-based over the flat value list.
  """ ;
  sh:path qudt:conformsToTupleSpec ;
  sh:class qudt:NTupleSpec ;
  sh:maxCount 1 .

# Rank check: the number of entries in the qudt:dimensions list must equal
# qudt:dimensionality. (Replaces the retired, broken qudt:DimensionalityShape.)

qudt:ArrayRankCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "Array dimensionality ({?dimensionality}) does not equal the number of dimensions listed ({?dimensionCount})." ;
    sh:select """
        SELECT $this ?dimensionality ?dimensionCount
        WHERE {
            $this qudt:dimensionality ?dimensionality .
            {
                SELECT $this (COUNT(?dimensionCell) AS ?dimensionCount)
                WHERE {
                    $this qudt:dimensions ?dimensions .
                    ?dimensions rdf:rest* ?dimensionCell .
                    ?dimensionCell rdf:first ?dimension .
                }
                GROUP BY $this
            }
            FILTER ( ?dimensionCount != ?dimensionality )
        }
    """ .

qudt:ArrayDataOrder
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>The order in which the values of a multi-dimensional array are laid out in the array's single
  flat value list. Two orderings are defined: <em>Innermost Index Fastest</em>, in which the
  innermost (last) index varies fastest, and <em>Outermost Index Fastest</em>, in which the
  outermost (first) index varies fastest. See the individual values for worked examples.</p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Array data order" ;
  rdfs:subClassOf qudt:EnumeratedValue ;
  sh:in ( qudt:InnermostIndexFastest qudt:OutermostIndexFastest ) .

qudt:AssociativeArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An <em>Associative Array</em> (or <em>Map</em>) is an abstract data type composed of a collection of keys and a collection of values,
   where each key is associated with one value. 
  The operation of finding the value associated with a key is called a lookup or indexing,
   and this is the most important operation supported by an associative array.
  The relationship between a key and its value is sometimes called a mapping or binding.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Associative Array" ;
  rdfs:seeAlso qudt:Map ;
  rdfs:subClassOf qudt:Array .

qudt:BalancedTree
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Balanced Tree</em> is a data type that defines the properties of data structures that represent balanced trees. 
  A balanced tree is a tree where no leaf is much farther away from the root than any other leaf. 
  Different balancing schemes allow different definitions of "much farther" and different amounts of work to keep them balanced.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Balanced Tree Type" ;
  rdfs:subClassOf qudt:Tree ;
  sh:property qudt:BalancedTree-maxDepth .

qudt:BinaryTree
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Binary Tree</em> is a data type that defines the properties of data structures that represent binary trees. 
  A binary tree is a tree in which each node has at most 2 children.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Binary Tree Type" ;
  rdfs:subClassOf qudt:Tree .

qudt:Collection
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A collection is a grouping of some variable number of zero or more data items that need to be operated upon together in some controlled fashion. 
  Generally, the data items will all share the same data type or are derived from some common ancestor data type.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Collection Type" ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:CompositeDataStructure
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Composite Data Structure</em>, also referred to as <em>Data Record</em> is a datatype that aggregates element of possibly different types. 
  The aggregated items are called fields or members and are usually identified or indexed by field labels.
  </p>"""^^rdf:HTML ;
  prov:wasInfluencedBy <https://en.wikipedia.org/wiki/List_of_data_structures> ;
  prov:wasInfluencedBy <https://en.wikipedia.org/wiki/Record_(computer_science)> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Composite Data Structure" ;
  rdfs:subClassOf qudt:CompositeDatatype ;
  sh:property qudt:CompositeDataStructure-dataElement .

qudt:CompositeDatatype
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Composite Datatype</em> is a datatype that is constructed from basic primitive types and other composite types. 
  </p>"""^^rdf:HTML ;
  prov:wasInfluencedBy <https://en.wikipedia.org/wiki/List_of_data_structures> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Composite Data Type" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:CompositeDatatype-alignment ;
  sh:property qudt:CompositeDatatype-padding .

qudt:CompositeTable
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'Table Type'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Composite Table Type" ;
  rdfs:subClassOf qudt:TableType .

qudt:DataSetElement
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A field is a tuple that carries a name, a type and optionally other properties that characterize a member element of a composite data structure.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "DataSet Element" ;
  rdfs:subClassOf qudt:DataItem ;
  rdfs:subClassOf qudt:NTuple ;
  sh:property qudt:DataSetElement-elementLabel ;
  sh:property qudt:DataSetElement-optional ;
  sh:property qudt:DataSetElement-quantityKind .

qudt:Dictionary
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A \"Map\"." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Dictionary Type" ;
  rdfs:subClassOf qudt:Map .

# qudt:DimensionalityShape removed — it walked qudt:value (singular), fired once
# per dimension entry, and did not project $this in its sub-SELECT. Replaced by
# qudt:ArrayRankCheck (rank) and qudt:ValuesListLengthCheck (extent), both on qudt:Array.

qudt:EngineeringValueTupleMember
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A sub-type of 'Tuple Member Type'. 
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Engineering Value Tuple Member" ;
  rdfs:subClassOf qudt:TupleMember ;
  sh:property qudt:EngineeringValueTupleMember-elementType .

qudt:FieldType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A sub-type of 'Composite Data Type'.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Field Type" ;
  rdfs:subClassOf qudt:CompositeDatatype ;
  sh:property qudt:FieldType-elementName ;
  sh:property qudt:FieldType-elementType ;
  sh:property qudt:FieldType-fieldLabel ;
  sh:property qudt:FieldType-fieldType .

qudt:FixedIntervalTimeSeriesArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.
  For example, data that has been sampled over uniformly spaced time intervals.
  A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Fixed Interval Time Series Array Type" ;
  rdfs:subClassOf qudt:TimeSeriesArrayType .

qudt:FixedIntervalTimeSeriesArrayType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """<p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.
 For example, data that has been sampled over uniformly spaced time intervals. 
 A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.
 </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Fixed Interval Time Series Array Type" ;
  rdfs:subClassOf qudt:TimeSeriesArrayType .

qudt:Graph
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Graph</em> is an instance of a kind of abstract data type, that consists of a set of nodes (also called vertices) and a set of edges that establish relationships (connections) between the nodes. 
  A Graph Type is a data type that defines the properties of data structures that represent graphs and their members (nodes and edges).
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Graph Type" ;
  rdfs:subClassOf qudt:DataItem .

qudt:Heap
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A heap is a specialized tree-based data structure that satisfies the condition: if B is a child node of A, then $key(A) \\ge key(B)$. 
  This implies that an element with the greatest key is always in the root node, and so such a heap is sometimes called a max heap. 
  Alternatively, if the comparison is reversed, the smallest element is always in the root node, which results in a min heap. 
  The function or method that implements the key() operator is specified by the heap type.
  </p>"""^^rdf:HTML ;
  prov:wasInfluencedBy <http://en.wikipedia.org/wiki/Heap_(data_structure)> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Heap" ;
  rdfs:subClassOf qudt:OrderedTree .

qudt:HeterogenousArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Heterogenous Array</em> is an array value whose cells may be of different
  data types. Like any <code>qudt:Array</code> it carries only the flat value list
  (<code>qudt:values</code>) plus a <code>qudt:datatypeKind</code> pointer; the pointer must
  resolve to a <code>qudt:HeterogenousArrayKind</code>, which supplies the per-position element
  types through <code>qudt:conformsToTupleSpec</code>.
  </p>
  <p>A heterogeneous array is an N-Tuple laid out in a grid, so it reuses the N-Tuple
  constraints verbatim, with positions 1-based over the flat value list. The array-level
  <code>qudt:ValuesListLengthCheck</code> (values = elementCount) and these N-Tuple checks
  together tie value count, element count and spec positions to one another.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Heterogenous Array" ;
  rdfs:subClassOf qudt:Array ;
  sh:property qudt:HeterogenousArray-datatypeKind ;
  sh:sparql qudt:NTupleTypeCheck ;
  sh:sparql qudt:NTupleLengthCheck ;
  sh:sparql qudt:NTupleExtraValueCheck ;
  sh:sparql qudt:NTupleMissingRequiredValueCheck .

qudt:HeterogenousArray-datatypeKind
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:class qudt:HeterogenousArrayKind ;
  sh:maxCount 1 ;
  sh:path qudt:datatypeKind .

qudt:HeterogenousArrayKind
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Heterogenous Array Kind></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. 
  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.
  </p>
  <p>The key considerations for a <em>Heterogenous Array Kind</em> are:
  </p>
  <ol>
  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>
  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>
  <li>Heterogenous Elements: all elements in the array may be of different data types;</li>
  <li>Contiguous Memory Allocation: 
    the elements are stored in consecutive memory locations, which allows efficient access using the index.</li>
  </ol>
  <p>The array is represented as ordered entries of values arranged according to its dimensionality.
  The number of dimensions is specified in the attribute 'dimensionality'.
  </p>
  <p>The property 'qudt:datatype' refers to a list if the datatypes of the elements.  
  </p>
  <p>A heterogeneous array is an N-Tuple laid out in a grid: 
   its per-position element types are given by a qudt:NTupleSpec via qudt:conformsToTupleSpec,
   so it reuses the N-Tuple constraints verbatim (positions are 1-based over
   the flat qudt:values list).
  The array-level qudt:ValuesListLengthCheck (values = elementCount) and these NTuple checks together tie value count,
  element count, and spec positions to one another.
  </p>
  <p>An heterogenous array can be multi-dimensional.
  Multiple indices are used but they are treated as extensions of the same structure.
  For example: for a 2D array arr[2][3], indices refer to the row and column positions.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Heterogenous Array Kind" ;
  rdfs:subClassOf qudt:ArrayKind ;
  sh:property qudt:HeterogenousArray-datatype .

qudt:HomogeneousArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Homogeneous Array</em> is an array value whose cells are all of the same data
  type. Like any <code>qudt:Array</code> it carries only the flat value list
  (<code>qudt:values</code>) plus a <code>qudt:datatypeKind</code> pointer; the pointer must
  resolve to a <code>qudt:HomogeneousArrayKind</code>, which supplies the single shared
  element type through <code>qudt:elementType</code>.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Homogeneous Array" ;
  rdfs:subClassOf qudt:Array ;
  sh:property qudt:HomogeneousArray-datatypeKind .

qudt:HomogeneousArray-datatypeKind
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:class qudt:HomogeneousArrayKind ;
  sh:maxCount 1 ;
  sh:path qudt:datatypeKind .

qudt:HomogeneousArrayKind
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Homogeneous Array Kind></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. 
  Each element in the array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.
  </p>
  <p>The key considerations for a <em>Homogeneous Array Kind</em> are:
  </p>
  <ol>
  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>
  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>
  <li>Homogeneous Elements: all elements in an array must be of the same datatype;</li>
  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>
  </ol>
  <p>A <em>Homogeneous Array Kind</em> is represented as ordered entries of values arranged according to its dimensionality.
  The number of dimensions is specified in the attribute 'dimensionality'.
  </p>
  <p>The property 'qudt:datatype' refers to the datatype of the elements.  
  </p>
  <p>An array can be multi-dimensional.
  Multiple indices are used but they are treated as extensions of the same structure.
  For Example: for a 2D array arr[2][3], indices refer to the row and column positions.
  A 2D array is still represented as a list, where each member of the list is a list.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Homogeneous Array Kind" ;
  rdfs:subClassOf qudt:ArrayKind .

qudt:InnermostIndexFastest
  a qudt:ArrayDataOrder ;
  dcterms:description """
  <p>The array values are held in a single flat list in which the innermost (last) index varies
  fastest: values that share the same outer indices occur contiguously before the outer index
  advances. For a 2-dimensional array arr[2][3] the values are ordered
  arr[0][0], arr[0][1], arr[0][2], arr[1][0], arr[1][1], arr[1][2].
  This is the default ordering when an array does not state a qudt:dataOrder.</p>
  """^^rdf:HTML ;
  dtype:literal "innermostIndexFastest" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Innermost Index Fastest" .

qudt:IntegerListShape
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:subClassOf qudt:List ;
  sh:property [
    sh:datatype xsd:integer ;
    sh:path rdf:first ;
  ] ;
  sh:property [
    sh:or ( [
      sh:node ( ) ;
    ] [
      sh:node qudt:IntegerListShape ;
    ] ) ;
    sh:path rdf:rest ;
  ] .

qudt:InterpolatedTable
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'Table Type'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Interpolated Table Type" ;
  rdfs:subClassOf qudt:TableType .

qudt:LargeObject
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). 
  They often are used to allow efficient, random, piece-wise access to the data.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Large object" ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:List
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'AbstractDataItem'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "List" ;
  rdfs:subClassOf qudt:DataItem ;
  sh:property qudt:DatatypePropertyShape ;
  sh:property qudt:MaybeQuantityPropertyShape ;
  sh:property qudt:MaybeUnitPropertyShape .

qudt:Map
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A Map Type is an abstract data type that defines the properties of map data structures. 
  A Map (or Associative Array) is an abstract data structure composed of a collection of keys and a collection of values,
   where each key is associated with one value. 
  The operation of finding the value associated with a key is called a lookup or indexing,
   and this is the most important operation supported by an associative array. 
  The relationship between a key and its value is sometimes called a mapping or binding.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Map Type" ;
  rdfs:seeAlso qudt:AssociativeArray ;
  rdfs:subClassOf qudt:Collection .

qudt:MassPropertiesArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Mass Properties Array</em> holds, for an object, four values for the properties:
   Center of Gravity, Mass, Moment of Inertia, and Product of Inertia. </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Mass Properties Array" ;
  rdfs:subClassOf qudt:HeterogenousArray .

qudt:Matrix
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Matrix</em> is a datatype that specifies the properties of an N-dimensional data structure.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Matrix" ;
  rdfs:subClassOf qudt:Array .

qudt:Matrix-2X4-FLOAT-SP
  a qudt:Matrix ;
  qudt:datatype datatype:FLOAT-SP ;
  qudt:dimensionality 2 ;
  qudt:dimensions (
      2
      4
    ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Matrix example 2x4 - Single Precision" ;
.

qudt:Matrix-4X4-FLOATDP
  a qudt:Matrix ;
  qudt:datatype datatype:FLOAT-DP ;
  qudt:dimensionality 2 ;
  qudt:dimensions (
      4
      4
    ) ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Matrix example 4x4 - Double precision" ;
.

qudt:MultiDimensionalArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Multi-Dimensional Array</em> is an extension of a standard one-dimensional array,
   where elements are organized in a grid-like structure across two or more dimensions. 
  It is a collection of elements arranged in a tabular or multi-dimensional structure for representing complex datasets,
   such as matrices, tensors, or higher-dimensional data.
  </p>
  <p>The elements of a multi-dimensional array are N-tuples, where 'N' corresponds to the dimensionality of the array.
  Each element is specified using the property 'qudt:element'.
  </p>
  <p>Ordinary or one-dimensional arrays are indexed by a single integer. 
  For a multi-dimensional array, the index into the array uses an ordered list of integers, such as in 'a[3,1,5]'. 
  The length of the list of integers used to index into the multi-dimensional array is always the same.
  This is referred to as the array's dimensionality. 
  The bounds on each of these are called the array's dimensions.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Multi-Dimensional Array Type" ;
  rdfs:subClassOf qudt:Array .

qudt:MultiDimensionalDataFormat
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  Data formats for storing and manipulating scalar and multidimensional data in a platform and discipline independent manner,
   for example HDF, CDF and netCDF.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Multi dimensional data format" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:MultiDimensionalDataFormat-descriptor .

qudt:MultiSet
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A bag is a set in which elements may be repeated." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Bag" ;
  rdfs:subClassOf qudt:Collection .

qudt:NTuple
    a rdfs:Class, sh:NodeShape ;
    dcterms:description """
  <p>An <em>N-Tuple</em> is an <em>Ordered List</em> of objects, each of a specified type. 
  The <em>n</em> can be any non-negative integer.
  </p>"""^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:label "N-Tuple" ;
    rdfs:subClassOf qudt:StructuredDatatype ;
    sh:property qudt:NTuple-conformsToTupleSpec ;
    sh:property qudt:NTuple-values;
    sh:sparql qudt:NTupleTypeCheck ;
    sh:sparql qudt:NTupleRangeCheck ;
    sh:sparql qudt:NTupleExtraValueCheck ;
    sh:sparql qudt:NTupleMissingRequiredValueCheck ;
    sh:sparql qudt:NTupleLengthCheck .

#################################################################
# 1. Tuple Member Type Check
#################################################################

qudt:NTupleTypeCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "N-Tuple value at position {?index} does not satisfy the member specification." ;
    sh:select """
        SELECT $this ?index ?value
        WHERE {
            # A qudt:NTuple states its spec directly; a heterogeneous qudt:Array
            # reaches it through its qudt:datatypeKind blueprint.
            $this ( qudt:conformsToTupleSpec | qudt:datatypeKind/qudt:conformsToTupleSpec ) ?spec .

            ?spec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?memberSpec .
            ?memberSpec qudt:index ?index .

            # Only check positions whose memberSpec actually declares a type expectation
            FILTER EXISTS {
                ?memberSpec ( sh:datatype | sh:or | sh:class | qudt:value | sh:nodeKind ) ?anyConstraint .
            }

            {
                SELECT $this ?value (COUNT(?previousCell) + 1 AS ?position)
                WHERE {
                    $this qudt:values ?values .
                    ?values rdf:rest* ?valueCell .
                    ?valueCell rdf:first ?value .

                    OPTIONAL {
                        ?values rdf:rest* ?previousCell .
                        ?previousCell rdf:rest+ ?valueCell .
                    }
                }
                GROUP BY $this ?value ?valueCell
            }

            # Correlate the computed position with the memberSpec's declared index.
            FILTER ( ?position = ?index )

            # Each of the four memberSpec patterns is probed with its own OPTIONAL;
            # the value is a violation iff none of them matched. (Expressed this
            # way rather than as UNION branches inside FILTER NOT EXISTS, which
            # is not portable: engines that do not substitute the outer ?value
            # and ?memberSpec into a UNION'd EXISTS group flag every position.)

            # (1) Numeric datatype — direct sh:datatype, or one inside an sh:or union
            OPTIONAL {
                ?memberSpec ( sh:datatype | sh:or/rdf:rest*/rdf:first/sh:datatype ) ?allowedDatatype .
                FILTER ( datatype(?value) = ?allowedDatatype )
                BIND ( true AS ?datatypeMatch )
            }
            # (2) Concept class membership — sh:class <C> where <C> a qudt:Concept
            OPTIONAL {
                ?memberSpec sh:class ?targetClass .
                ?value rdf:type/rdfs:subClassOf* ?targetClass .
                BIND ( true AS ?classMatch )
            }
            # (3) Enumerated value — qudt:value <enum1>, <enum2>, ...
            OPTIONAL {
                ?memberSpec qudt:value ?value .
                BIND ( true AS ?enumeratedMatch )
            }
            # (4) Any IRI — sh:nodeKind sh:IRI on the memberSpec
            OPTIONAL {
                ?memberSpec sh:nodeKind sh:IRI .
                FILTER ( isIRI(?value) )
                BIND ( true AS ?iriMatch )
            }

            FILTER ( !BOUND(?datatypeMatch) && !BOUND(?classMatch)
                     && !BOUND(?enumeratedMatch) && !BOUND(?iriMatch) )
        }
    """ .

#################################################################
# 2. Extra Value Check
#################################################################

qudt:NTupleExtraValueCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "N-Tuple has a value at a position not declared by its tuple specification." ;
    sh:select """
        SELECT $this ?index ?value
WHERE {
    # A qudt:NTuple states its spec directly; a heterogeneous qudt:Array
    # reaches it through its qudt:datatypeKind blueprint.
    $this ( qudt:conformsToTupleSpec | qudt:datatypeKind/qudt:conformsToTupleSpec ) ?spec .

    {
        SELECT $this ?value (COUNT(?previousCell) + 1 AS ?index)
        WHERE {
            $this qudt:values ?values .
            ?values rdf:rest* ?valueCell .
            ?valueCell rdf:first ?value .

            OPTIONAL {
                ?values rdf:rest* ?previousCell .
                ?previousCell rdf:rest+ ?valueCell .
            }
        }
        GROUP BY $this ?value ?valueCell
    }

    FILTER NOT EXISTS {
        ?spec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?memberSpec .
        ?memberSpec qudt:index ?index .
    }
}
    """ .

#################################################################
# 3. Missing Required Value Check
#################################################################

qudt:NTupleMissingRequiredValueCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "N-Tuple is missing a required value declared by its tuple specification." ;
    sh:select """
        SELECT $this ?index
WHERE {
    # A qudt:NTuple states its spec directly; a heterogeneous qudt:Array
    # reaches it through its qudt:datatypeKind blueprint.
    $this ( qudt:conformsToTupleSpec | qudt:datatypeKind/qudt:conformsToTupleSpec ) ?spec .

    ?spec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?memberSpec .
    ?memberSpec qudt:index ?index .

    OPTIONAL { ?memberSpec sh:minCount ?minCount . }
    FILTER ( !BOUND(?minCount) || ?minCount > 0 )

    # Values occupy positions 1..N contiguously, so a required position is
    # missing exactly when its index exceeds the number of values present.
    {
        SELECT $this (COUNT(?valueCell) AS ?valueCount)
        WHERE {
            $this qudt:values ?values .
            ?values rdf:rest* ?valueCell .
            ?valueCell rdf:first ?value .
        }
        GROUP BY $this
    }

    FILTER ( ?index > ?valueCount )
}
    """ .

#################################################################
# 4. Length Check
#################################################################

qudt:NTupleLengthCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "N-Tuple length ({?valueCount}) is outside the range permitted by the tuple specification ({?requiredCount} required, {?totalCount} total)." ;
    sh:select """
        SELECT $this ?valueCount ?requiredCount ?totalCount
WHERE {
    {
        SELECT $this (COUNT(?valueCell) AS ?valueCount)
        WHERE {
            $this qudt:values ?values .
            ?values rdf:rest* ?valueCell .
            ?valueCell rdf:first ?value .
        }
        GROUP BY $this
    }

    # Total declared positions.
    {
        SELECT $this (COUNT(?memberSpec) AS ?totalCount)
        WHERE {
            # A qudt:NTuple states its spec directly; a heterogeneous qudt:Array
            # reaches it through its qudt:datatypeKind blueprint.
            $this ( qudt:conformsToTupleSpec | qudt:datatypeKind/qudt:conformsToTupleSpec ) ?spec .
            ?spec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?memberSpec .
        }
        GROUP BY $this
    }

    # Required positions: a member spec is optional only if it declares sh:minCount 0.
    {
        SELECT $this (COUNT(?requiredSpec) AS ?requiredCount)
        WHERE {
            $this qudt:conformsToTupleSpec ?rspec .
            ?rspec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?requiredSpec .
            OPTIONAL { ?requiredSpec sh:minCount ?minCount . }
            FILTER ( !BOUND(?minCount) || ?minCount > 0 )
        }
        GROUP BY $this
    }

    # Valid length lies in [requiredCount, totalCount]; anything outside is a violation.
    # (Assumes optional members are trailing, e.g. LIST [3:4].)
    FILTER ( ?valueCount < ?requiredCount || ?valueCount > ?totalCount )
}
    """ .

#################################################################
# 5. Range Check (per-position numeric bounds)
#################################################################

qudt:NTupleRangeCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "N-Tuple value {?value} at position {?index} is outside the range declared by its member specification." ;
    sh:select """
        SELECT $this ?index ?value
        WHERE {
            # A qudt:NTuple states its spec directly; a heterogeneous qudt:Array
            # reaches it through its qudt:datatypeKind blueprint.
            $this ( qudt:conformsToTupleSpec | qudt:datatypeKind/qudt:conformsToTupleSpec ) ?spec .
            ?spec qudt:tupleMemberSpecs/rdf:rest*/rdf:first ?memberSpec .
            ?memberSpec qudt:index ?index .

            # Only positions whose memberSpec declares at least one numeric bound.
            FILTER EXISTS {
                ?memberSpec ( sh:minInclusive | sh:maxInclusive | sh:minExclusive | sh:maxExclusive ) ?anyBound .
            }

            {
                SELECT $this ?value (COUNT(?previousCell) + 1 AS ?position)
                WHERE {
                    $this qudt:values ?values .
                    ?values rdf:rest* ?valueCell .
                    ?valueCell rdf:first ?value .

                    OPTIONAL {
                        ?values rdf:rest* ?previousCell .
                        ?previousCell rdf:rest+ ?valueCell .
                    }
                }
                GROUP BY $this ?value ?valueCell
            }

            # Correlate the computed position with the memberSpec's declared index.
            FILTER ( ?position = ?index )

            OPTIONAL { ?memberSpec sh:minInclusive ?minInclusive . }
            OPTIONAL { ?memberSpec sh:maxInclusive ?maxInclusive . }
            OPTIONAL { ?memberSpec sh:minExclusive ?minExclusive . }
            OPTIONAL { ?memberSpec sh:maxExclusive ?maxExclusive . }

            FILTER (
                   ( BOUND(?minInclusive) && ?value <  ?minInclusive )
                || ( BOUND(?maxInclusive) && ?value >  ?maxInclusive )
                || ( BOUND(?minExclusive) && ?value <= ?minExclusive )
                || ( BOUND(?maxExclusive) && ?value >= ?maxExclusive )
            )
        }
    """ .

qudt:NTuple-conformsToTupleSpec
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:maxCount 1 ;
  sh:minCount 1 ;
  sh:path qudt:conformsToTupleSpec ;
  sh:class qudt:NTupleSpec .

qudt:NTupleSpec
    a rdfs:class, sh:NodeShape ;
    dcterms:description """
    <p>A SHACL node shape that defines the ordered member constraints
        for a tuple. A tuple specification contains an RDF list of
        member specifications, each describing the constraints for a
        particular tuple position.
    </p>
    """ ;
    rdfs:label "N-Tuple Specification" ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:property [
        sh:path qudt:tupleMemberSpecs ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node qudt:RDFListShape ;
    ] ;
    sh:property [
        sh:path (
            qudt:tupleMemberSpecs
            [ sh:zeroOrMorePath rdf:rest ]
            rdf:first
        ) ;
        sh:class qudt:NTupleMemberTypeSpec ;
        sh:node qudt:NTupleMemberTypeSpec ;
    ] ;
    .

qudt:NTupleMemberTypeSpec
    a rdfs:Class , sh:NodeShape ;
    dcterms:description """
    <p>A specification for a tuple position. Member specifications
    may use standard SHACL constraint properties such as sh:datatype, sh:class, sh:node, sh:in,
    sh:minInclusive, and sh:maxInclusive.
    </p>
    """^^rdf:HTML ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:label "N-Tuple Member Type Specification" ;
    sh:property qudt:NTupleMemberTypeSpec-index ;
    sh:property qudt:NTupleMemberTypeSpec-type ;
    .

qudt:NTupleMemberTypeSpec-index
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:path qudt:index ;
  sh:datatype xsd:integer ;
  sh:minInclusive 1 ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  .

qudt:NTupleMemberTypeSpec-type
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:node (
      [
        sh:or qudt:NumericTypeUnion ;
      ]
      [
        sh:property [
            sh:path sh:class ;
            sh:class qudt:Concept ;
          ] ;
      ]
      [
        sh:property [
            sh:path qudt:value ;
            sh:class qudt:EnumeratedValue ;
          ] ;
      ]
      [
        sh:nodeKind sh:IRI ;
      ]
    ) ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  .

qudt:NTuple-values
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:maxCount 1 ;
  sh:minCount 1 ;
  sh:path qudt:values ;
  sh:node qudt:RDFListShape  .

qudt:OrderedCollection
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An <em>Ordered Collection Kind</em> is an abstract data type that defines the properties of collection data structures whose members can be linearly ordered. 
  An ordered collection is a collection together with an ordering relation (such as greater than) that linearly orders the collection elements.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Ordered Collection Kind" ;
  rdfs:subClassOf qudt:Collection ;
  sh:property qudt:OrderedCollection-orderingRelation .

qudt:OrderedTree
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>An "Ordered Tree Type" is a data type that defines the properties of data structures that represent ordered trees. 
  An ordered tree is a tree where the children of every node are ordered, that is, there is a first child, second child, third child, etc. 
  Typically a type specification for an ordered tree will include the comparison operator (such as <b>lt</b> or <b>gt</b>) that is used to order the nodes.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Ordered Tree Type" ;
  rdfs:subClassOf qudt:OrderedCollection ;
  rdfs:subClassOf qudt:Tree .

qudt:OutermostIndexFastest
  a qudt:ArrayDataOrder ;
  dcterms:description """
  <p>The array values are held in a single flat list in which the outermost (first) index varies
  fastest: values that share the same inner indices occur contiguously before the inner index
  advances. For a 2-dimensional array arr[2][3] the values are ordered
  arr[0][0], arr[1][0], arr[0][1], arr[1][1], arr[0][2], arr[1][2].</p>
  """^^rdf:HTML ;
  dtype:literal "outermostIndexFastest" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Outermost Index Fastest" .

qudt:PaddingType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>This describes how unused bits of a field are filled. 
  Unused bits could be set to one or zero. 
  A third option is "don't care".
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Padding type" ;
  rdfs:subClassOf qudt:EnumeratedValue ;
  sh:in ( datatype:PadWithOnes datatype:PadWithZeros datatype:PadWithAny ) .

qudt:PartialArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A partial array is an Array with two attributes that define the starting and ending indices of the elements that are provided.
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Partial Array" ;
  rdfs:subClassOf qudt:Array .

qudt:QuantityKindList
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Quantity Kind List</em> is a list of qudt:QuantityKind. 
  They are used, for instance, to specify the quantity kind in a Mass Properties Array. 
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Quantity kind List" ;
  rdfs:subClassOf qudt:List ;
  sh:property [
    sh:class qudt:QuantityKind ;
    sh:path rdf:first ;
  ] ;
  sh:property [
    sh:or ( [
      sh:node ( ) ;
    ] [
      sh:node qudt:QuantityKindList ;
    ] ) ;
    sh:path rdf:rest ;
  ] .

qudt:RawValueTupleMember
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'Tuple Member Type'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Raw value tuple member" ;
  rdfs:subClassOf qudt:TupleMember ;
  sh:property qudt:RawValueTupleMember-elementType .

qudt:RawValueTupleMemberType
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Raw value tuple member type" ;
  rdfs:subClassOf qudt:TupleMember ;
  sh:property qudt:RawValueTupleMember-elementType .

qudt:Record
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A Record Type is a type whose values are records, i.e. aggregates of several items of possibly different types. 
  The aggregated items are called fields or members and are usually identified or indexed by field labels.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Record Type" ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:ReferenceDatatype
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A reference is an object containing information which refers to data stored elsewhere, as opposed to containing the data itself. 
  A reference data type is a data type that specifies how a reference is represented and stored in memory,
   as well as the operations that can be performed on reference values. 
  The most common example of a reference data type is a pointer.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Reference Data Type" ;
  rdfs:subClassOf qudt:StructuredDatatype .

qudt:ScalarListShape
  a rdfs:Class, sh:NodeShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:subClassOf qudt:List ;
  sh:property [
    sh:or qudt:NumericTypeUnion ;
    sh:path rdf:first ;
  ] ;
  sh:property [
    sh:or ( [
      sh:node ( ) ;
    ] [
      sh:node qudt:ScalarListShape ;
    ] ) ;
    sh:path rdf:rest ;
  ] .

qudt:Sequence
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Sequence</em> is an enumerated collection of objects in which repetitions are allowed. 
  Like a set, it contains members (also called elements, or terms). 
  The number of elements (possibly infinite) is called the length of the sequence.
  </p>
  <p>Unlike a set, order matters, and exactly the same elements can appear multiple times at different positions in the sequence. 
  Formally, a sequence can be defined as a function whose domain is either the set of the natural numbers (for infinite sequences) or the set of the first n natural numbers (for a sequence of finite length n). 
  </p>
  <p>The position of an element in a sequence is its rank or index; it is the integer from which the element is the image. 
  It depends on the context or of a specific convention, if the first element has index 0 or 1. [Wikipedia]
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Sequence" ;
  rdfs:subClassOf qudt:Collection .

qudt:Set
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Set</em> is an abstract data type that defines the properties of sets. 
  A set is a collection (container) of certain values, without any particular order, and no repeated values. 
  It corresponds with a finite set in mathematics.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Set Type" ;
  rdfs:subClassOf qudt:Collection .

qudt:SplineCalibrator
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'Map Type'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Spline calibrator" ;
  rdfs:subClassOf qudt:Map .

qudt:SplinePoint
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A sub-type of 'Tuple Type'." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Spline point" ;
  rdfs:subClassOf qudt:NTuple .

qudt:StateSpaceMatrix
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>In control engineering, a state space representation is a mathematical model of a physical system
   as a set of input, output and state variables related by first-order differential equations. 
  To abstract from the number of inputs, outputs and states, the variables are expressed as vectors.
  The differential and algebraic equations are written in matrix form
   (the last one can be done when the dynamical system is linear and time invariant).
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "State Space Matrix Type" ;
  rdfs:subClassOf qudt:Matrix .

qudt:StructuredDatatype
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Structured Datatype</em>, in contrast to a scalar data type, is used to characterize classes of complex data structures.
  Examples are collections, linked and indexed lists, trees, ordered trees, and multi-dimensional file formats.
  </p>"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Structured Data Type" ;
  rdfs:subClassOf qudt:Datatype .

qudt:StructuredDatatype-nTuple
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:class qudt:NTuple ;
  sh:maxCount 1 ;
  sh:path qudt:nTuple .

qudt:TableType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Table Type</em> specifies the properties of table data structures. 
  A table is both a mode of visual communication and a means of arranging data. 
  The precise conventions and terminology for describing tables varies depending on the context. 
  Moreover, tables differ significantly in variety, structure, flexibility, notation, representation and use.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Table Type" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:DimensionsPropertyShape ;
  sh:property qudt:Table-byRow ;
  sh:property qudt:Table-columns ;
  sh:property qudt:Table-dimensionality ;
  sh:property qudt:Table-rows .

qudt:TimeSeriesArrayType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A <em>Time Series Array Type</em> specifies the properties of arrays that hold time series data. 
  A time series is a sequence of data points, measured at successive time intervals. 
  The time intervals may be uniformly or non-uniformly spaced.
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Time Series Array Type" ;
  rdfs:subClassOf qudt:ArrayKind ;
  sh:property qudt:TimeSeriesArray-incrementDatatype .

qudt:Tree
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  A "Tree" is a data type that defines the properties of data structures that represent trees. 
  Each node is either a leaf or an internal node. 
  An internal node has one or more child nodes and is called the parent of its child nodes. 
  Leaf nodes have no chidren. Nodes that share the same parent are siblings. 
  In graph theoretic terminology, a tree is a connected, undirected, acyclic graph.
  """ ;
  prov:wasInfluencedBy <http://en.wikipedia.org/wiki/Tree_(data_structure)> ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Tree Type" ;
  rdfs:subClassOf qudt:Graph .

qudt:RDFListShape
    a sh:NodeShape ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:or (
        [
            sh:hasValue rdf:nil
        ]
        [
            sh:property [
                sh:path rdf:first ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node qudt:RDFListShape ;
            ] ;
        ]
    ) .

qudt:TypeMatrix
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  Members of this class are matrix data structures that describe the datatypes of a class of matrices. 
  That is, the members of this class are matrices with cells that contain datatypes (c.f. type:Datatype) and are used to describe the datatype structure of other matrices.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Type matrix" ;
  rdfs:subClassOf qudt:Matrix .

qudt:TypeVector
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Type Vector</em> is a vector whose elements are data types. 
  They are used to specify the type of each component of a vector or class of vectors. 
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Type vector" ;
  rdfs:subClassOf qudt:Vector ;
  sh:property qudt:TypeVector-datatype .

qudt:ValuesList
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:description "The flat value list of an array." ;
  sh:path qudt:values ;
  sh:node qudt:RDFListShape ;
  sh:maxCount 1 .

qudt:ValuesListLengthCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:comment """
    Length check for the number of cells in the flat qudt:values list of a
    qudt:Array. This must equal the qudt:elementCount (= product of dimensions)
    declared by the array's qudt:datatypeKind.
    """ ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "Array value count ({?valueCount}) does not equal the declared element count ({?elementCount})." ;
    sh:select """
        SELECT $this ?valueCount ?elementCount
        WHERE {
            $this qudt:datatypeKind ?kind .
            ?kind qudt:elementCount ?elementCount .
            {
                SELECT $this (COUNT(?valueCell) AS ?valueCount)
                WHERE {
                    $this qudt:values ?values .
                    ?values rdf:rest* ?valueCell .
                    ?valueCell rdf:first ?value .
                }
                GROUP BY $this
            }
            FILTER ( ?valueCount != ?elementCount )
        }
    """ .

qudt:ValuesListElementTypeCheck
    a sh:SPARQLConstraint ;
    sh:prefixes <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    rdfs:comment """
    Element-type check (homogeneous arrays): every cell in the array's flat value
    list must satisfy the single qudt:elementType facet declared by its
    qudt:datatypeKind, either as a literal datatype or as membership of a class. Heterogeneous arrays are checked per position by
    the reused NTuple constraints (see qudt:HeterogenousArray).
    """ ;
    rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
    sh:message "Array element {?value} does not satisfy the array's element type {?elementType}." ;
    sh:select """
        SELECT $this ?value ?elementType
        WHERE {
            $this qudt:datatypeKind ?kind .
            ?kind qudt:elementType ?elementType .
            $this qudt:values ?values .
            ?values rdf:rest* ?valueCell .
            ?valueCell rdf:first ?value .

            OPTIONAL {
                ?value rdf:type/rdfs:subClassOf* ?elementType .
                BIND ( true AS ?classMatch )
            }
            BIND ( ( isLiteral(?value) && datatype(?value) = ?elementType ) AS ?datatypeMatch )
            FILTER ( !bound(?classMatch) && !COALESCE(?datatypeMatch, false) )
        }
    """ .

qudt:VariableIntervalTimeSeriesArray
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Variable Interval Time Series Array Type" ;
  rdfs:subClassOf qudt:TimeSeriesArrayType .

qudt:VariableIntervalTimeSeriesArrayType
  a rdfs:Class, sh:NodeShape ;
  dcterms:description "A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Variable Interval Time Series Array Type" ;
  rdfs:subClassOf qudt:TimeSeriesArrayType .

qudt:Vector
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Vector</em> is an array data type that can have a dimensionality of one, or more elements.
  </p>
  <p>Vectors can represent physical quantities, such as velocity, force, displacement;
  mathematical objects such as points or directions in space;
  and abstract representations for things such as colors, features, or embeddings in computational contexts.
  </p>
  <p>As a one-dimensional mathematical object it can represent a quantity with both magnitude and direction in space.
  One-dimensional vectors can be thought of as a special case of a 1D array.
  For example a 3D vector can be expressed as a list of coordinates: [x,y,z].
  </p>
  <p>
  A vector in n-dimensional space can represent a point, a direction, or a linear combination of basis vectors.
  </p>
  <p>Vectors can represent quantifiable values.
  For example a car moving at 60 m/hr to the north, assuming north is along the y-axis, can be represented in 2D as:
  </p>
  <dl>
  <dd>(0, 60)</dd>
  </dl>
  <p>
  In machine learning a <em>Feature Vector</em> can be expressed for a dataset entry as:
  <p>
  <dl>
  <dd>(5.1, 3.5, 1.4, 0.2)</dd>
  </dl>
  <p>
  In AI for text processing a <em>Word Embedding Vector</em> is expressed as a N-dimensional space,
   where N can be a large number.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Vector" ;
  rdfs:subClassOf qudt:StructuredDatatype ;
  sh:property qudt:ValuesList ;
  sh:property qudt:Vector-datatypeKind ;
  sh:sparql qudt:ValuesListLengthCheck ;
  sh:sparql qudt:ValuesListElementTypeCheck ;
  .

qudt:Vector-datatypeKind
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  sh:description """
  Optional rather than required, to bridge the legacy vector instances that still describe
  themselves with qudt:datatype / qudt:dimensions / qudt:value (singular). Tighten to
  sh:minCount 1 once those have been migrated to a qudt:VectorKind.
  """ ;
  sh:class qudt:VectorKind ;
  sh:minCount 0 ;
  sh:maxCount 1 ;
  sh:path qudt:datatypeKind .

qudt:VectorKind
  a rdfs:Class, sh:NodeShape ;
  dcterms:description """
  <p>A <em>Vector Kind</em> is the blueprint for a <code>qudt:Vector</code> value: it declares the
  number of components, the shared component type, and any shared quantity kind or unit.
  </p>
  <p>A vector is represented as a rank-1 array, which is why a <em>Vector Kind</em> is a kind of
  <code>qudt:ArrayKind</code>. The subsumption is representational rather than algebraic: a vector
  in the mathematical sense is an element of a vector space, closed under addition and scalar
  multiplication, and an array carries no such structure. This schema describes representation, so
  the containment holds in that sense only, and it does not hold in reverse -- an array of strings
  is not a vector.
  </p>
  <p>Because vector-space operations require every component to be drawn from a single field, a
  <em>Vector Kind</em> is homogeneous: it declares one shared <code>qudt:elementType</code> rather
  than per-position types.
  </p>
  """^^rdf:HTML ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "Vector Kind" ;
  rdfs:subClassOf qudt:ArrayKind .

qudt:alignment
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "alignment" .

qudt:arg1Type
  a rdf:Property ;
  dcterms:description "This property relates a function data type with the type of its arg1." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "arg1Type" ;
  rdfs:subPropertyOf qudt:argType .

qudt:arg2Type
  a rdf:Property ;
  dcterms:description "This property relates a function data type with the type of its arg2." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "arg2Type" ;
  rdfs:subPropertyOf qudt:argType .

qudt:arg3Type
  a rdf:Property ;
  dcterms:description "This property relates a function data type with the type of its arg3." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "arg3Type" ;
  rdfs:subPropertyOf qudt:argType .

qudt:argType
  a rdf:Property ;
  dcterms:description "This property relates a function data type with the type of one of its arguments." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "argType" ;
  rdfs:subPropertyOf qudt:elementDatatype .

qudt:datatypeKind
  a rdf:Property ;
  dcterms:description "This property connects an array with is type specification." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "array kind" .

qudt:byRow
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "by row" .

qudt:columns
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "columns" .

qudt:dataOrder
  a rdf:Property ;
  rdfs:comment "The order in which the values of a multi-dimensional array are laid out in the array's flat value list. When absent, the default is qudt:InnermostIndexFastest." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "data order" ;
  rdfs:range qudt:ArrayDataOrder .

qudt:datatype
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "datatype" .

qudt:descriptor
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "descriptor" .

qudt:dimensions
  a rdf:Property ;
  dcterms:description """
  The extent of each dimension making up an array or matrix.
  Dimensions are expressed as an integer list.
  For example a 4 by 4 array has dimensions (4 4), whereas a vector or a string has dimensions (1).
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "dimensions" .

qudt:elementDatatype
  a rdf:Property ;
  dcterms:description """
  This property is used to relate a structured data type with the data type the structured type's elements. 
  It is used for structured data types with elements that are all of the same type.
  """ ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "element datatype" .

qudt:elementLabel
  a rdf:Property ;
  dcterms:description "This property is used to label the field of a composite data structure." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "element label" .

qudt:elementName
  a rdf:Property ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "element name" .

qudt:elementCount
  a rdf:Property ;
  dcterms:description "The total number of elements (cells) in an array, equal to the product of its dimensions. Held explicitly so that the flat value list can be length-checked without a SPARQL PRODUCT aggregate." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "element count" ;
  rdfs:range xsd:integer .

qudt:elementType
  a rdf:Property ;
  dcterms:description "The single shared element type of a homogeneous array, given as a datatype IRI (matched against each cell's literal datatype) or a class IRI (matched against each cell's rdf:type). Heterogeneous arrays instead give per-position types via qudt:conformsToTupleSpec." ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/schema/shacl/datatype/structured> ;
  rdfs:label "element type" .

qudt:field
  a rdf:Property ;
