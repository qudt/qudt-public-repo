qudt:dimensionality
  a rdf:Property ;
  dcterms:description """
  The number of dimensions making up a matrix or an array. 
  For example a 4 by 4 array has a dimensionality of 2. 
  Whereas a vector or a string has a dimensionality of 1.
  """ ;
